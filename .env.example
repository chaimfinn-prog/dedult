# העתק קובץ זה ל-.env ומלא בערכים מ-Supabase (Project Settings → API).
# שני אלה ציבוריים ומוגנים ב-RLS — מותר שיהיו בצד הלקוח.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# הערה: מפתח The Odds API לא נשמר כאן! הוא נשמר ב-Secrets של Supabase:
#   supabase secrets set ODDS_API_KEY=xxxxx
